# Template of .env.prod for docker-compose.prod.yml (docs/deploy.md).
# Do not fill it in by hand: `sh docker/prod/init-env.sh` creates .env.prod with random secrets,
# then add the domain and the integration credentials. .env.prod never goes into git or chat.

# --- Address -------------------------------------------------------------------------------------------
# Domain of the dashboard, e.g. rnp.acme.example (DNS A record → the server).
RNP_DOMAIN=
# Port of the frontend on the server; the HTTPS proxy forwards the domain to 127.0.0.1:RNP_PORT.
RNP_BIND=127.0.0.1
RNP_PORT=3300
# true when HTTPS is terminated by a proxy in front (Caddy profile or the server's proxy) - the normal case.
RNP_TRUST_PROXY=true

# --- Secrets (generated) -------------------------------------------------------------------------------
APP_SECRET=
JWT_PASSPHRASE=
MARIADB_ROOT_PASSWORD=
MARIADB_PASSWORD=
MARIADB_DATABASE=rnp
MARIADB_USER=rnp

# --- Integrations (README.md, «Интеграции») ------------------------------------------------------------
# Platform API base WITHOUT /api, account dashboard_client (read only).
PLATFORM_API_URL=
PLATFORM_API_USERNAME=
PLATFORM_API_PASSWORD=
# Bitrix24 incoming webhook, scope crm (the URL contains the token).
BITRIX_WEBHOOK_URL=
# Anthropic API key for the AI features (review, drafts, assistant); empty = AI disabled.
ANTHROPIC_API_KEY=

# --- Backups -------------------------------------------------------------------------------------------
# Host directory for nightly dumps and how many days to keep them.
RNP_BACKUP_DIR=./backups
RNP_BACKUP_DAYS=14
