# Copy to .env.local and fill in. .env.local is gitignored and never committed.
# `make init` creates .env.local from this file with random APP_SECRET / JWT_PASSPHRASE.

APP_SECRET=change-me-random-32-hex
JWT_PASSPHRASE=change-me-random-64-hex

# Acme platform API (read-only machine client dashboard_client).
# Base URL WITHOUT /api, e.g. https://api.example.com; endpoints are appended as /api/...
PLATFORM_API_URL=
PLATFORM_API_USERNAME=dashboard_client
PLATFORM_API_PASSWORD=

# Bitrix24 incoming webhook, scope crm: https://acme.bitrix24.example/rest/<user>/<token>/
BITRIX_WEBHOOK_URL=
