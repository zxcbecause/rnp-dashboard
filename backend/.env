# Committed defaults. NO SECRETS HERE: real values go to .env.local (gitignored),
# see .env.local.example for the full list of variables.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost:8081
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Local docker MariaDB (service "mariadb" in ../docker-compose.yml). Local-only credentials.
DATABASE_URL="mysql://rnp:rnp@mariadb:3306/rnp?serverVersion=11.4.0-MariaDB&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=
###< lexik/jwt-authentication-bundle ###

###> symfony/lock ###
LOCK_DSN=flock
###< symfony/lock ###

###> integrations (used from the next session on) ###
PLATFORM_API_URL=
PLATFORM_API_USERNAME=
PLATFORM_API_PASSWORD=
BITRIX_WEBHOOK_URL=
# Anthropic API key for the AI features (put it into .env.local / .env.prod, never here). Empty = AI disabled.
ANTHROPIC_API_KEY=
###< integrations ###
