# Test-only values: throwaway keys generated locally, not secrets.
KERNEL_CLASS='App\Kernel'
APP_SECRET='test-secret-not-used-anywhere-else'
JWT_PASSPHRASE='test-passphrase'
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/test/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/test/public.pem
# Fake platform API: every request is answered by test.platform_http_client (MockHttpClient).
PLATFORM_API_URL=http://platform.test
PLATFORM_API_USERNAME=dashboard_client
PLATFORM_API_PASSWORD=test-password
# Fake Bitrix24 webhook: answered by test.bitrix_http_client (MockHttpClient).
BITRIX_WEBHOOK_URL=https://bitrix.test/rest/1/test-token/
# The model is replaced by tests/Support/Ai/FakeLlmClient; the value only marks AI as configured.
ANTHROPIC_API_KEY=test-key
